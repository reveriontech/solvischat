# Google Gemini API Key
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=api_key_here

# Cloudflare Pages (npm run deploy): .env is NOT used on the edge. Set the same
# name in the Pages project: Settings → Environment variables → Production,
# or: npx wrangler pages secret put GEMINI_API_KEY --project-name=stella-chat

# Server port (optional, defaults to 3001)
PORT=3001

# Node environment (development or production)
NODE_ENV=development
