# Google Gemini API Key
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=api_key_here
#
# Fallback alias (supported by the app; useful if your platform already has this name set)
# OPENAI_API_KEY=api_key_here

# Optional; Cloudflare Pages defaults to gemini-2.5-flash-lite if unset
# GEMINI_MODEL=gemini-2.5-flash-lite

# Cloudflare Pages (npm run deploy): .env is NOT used on the edge. Set the same
# name in the Pages project: Settings → Environment variables → Production,
# or: npx wrangler pages secret put GEMINI_API_KEY --project-name=stella-chat

# Server port (optional, defaults to 3001)
PORT=3001

# Node environment (development or production)
NODE_ENV=development
